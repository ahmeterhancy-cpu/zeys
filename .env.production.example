# ============================================================================
# CANLI ORTAM ORNEGI — bu dosya depoya GIRER, degerleri BOS kalir.
#
# Gercek .env sunucuda cPanel Dosya Yoneticisi ile olusturulur
# (Ayarlar > Gizli Dosyalari Goster acik olmali). Depo public oldugu
# icin buraya yazilan her deger herkese acik sayilir; git gecmisi de
# okunabilir, yani bir kez commit'lenen parola YANMIS sayilir.
# ============================================================================

APP_NAME="Zeys Fashion House"
APP_ENV=production
# php artisan key:generate ile uretilir, buraya YAZILMAZ
APP_KEY=
APP_DEBUG=false
APP_URL=https://zeysfashionhouse.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# VERITABANI
#
# TUZAK: DB_HOST olarak 127.0.0.1 YAZMAYIN. cPanel yetkiyi @localhost
# verir; TCP baglantisi baska bir kimlik sayilir ve baglanti reddedilir.
# "localhost" yazin.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# E-POSTA (cPanel hesabi)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# GORSELLER
#
# cPanel sembolik baglari takip etmiyorsa storage bagi calismaz. O durumda
# gorselleri public_html/storage icinde GERCEK bir klasorde tutun ve bu
# degeri oraya yoneltin.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public
# Bag calismiyorsa (gorseller 404) asagiyi acin ve gercek klasore yoneltin:
# FILESYSTEM_PUBLIC_ROOT=/home/KULLANICI/public_html/storage

# ---------------------------------------------------------------------------
# MAGAZA
# ---------------------------------------------------------------------------
SHOP_AD="Zeys Fashion House"
SHOP_ALAN_ADI=zeysfashionhouse.com
SHOP_INSTAGRAM=zeysfashionhouse
SHOP_KARGO_UCRET=99.00
SHOP_KARGO_UCRETSIZ_ESIGI=1500.00
SHOP_KARGO_FIRMA=
SHOP_SIPARIS_BILDIRIM=
SHOP_DUSUK_STOK_ESIGI=3
SHOP_BAKIM_MODU=false

# Yasal metinlerde ve faturada gorunur — BOS BIRAKILIRSA metinlerde
# [GIRILMEDI] yer tutuculari cikar.
SHOP_SATICI_UNVAN=
SHOP_SATICI_ADRES="Cumhuriyet Mahallesi 3049. Sokak No:3, Edirne Life 5 — Edirne/Merkez"
SHOP_SATICI_TELEFON=
SHOP_SATICI_EPOSTA=
SHOP_SATICI_MERSIS=
SHOP_SATICI_VERGI_DAIRESI=
SHOP_SATICI_VERGI_NO=

# ---------------------------------------------------------------------------
# PAYTR
#
# Uc deger de PayTR magaza panelinden alinir. Callback adresini PayTR
# panelinde ELLE tanimlamak gerekir:
#   https://zeysfashionhouse.com/paytr/callback
#
# TEST_MODE=1 iken gercek para cekilmez. Canliya gecerken 0 yapin.
# ---------------------------------------------------------------------------
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

# Odeme ucunda sertifika dogrulamasi ACIK kalmali. Yerelde CA paketi
# yoksa false yapilabilir, canlida ASLA.
PAYTR_VERIFY_TLS=true
